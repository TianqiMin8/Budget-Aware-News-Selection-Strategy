# Python bytecode and local environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Packaging and test artifacts
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local secrets and editor state
.env
.vscode/
.idea/

# Downloaded/raw datasets and generated experiment outputs
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep
